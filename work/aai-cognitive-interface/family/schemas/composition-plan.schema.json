{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aai-composition-plan",
  "title": "AAI mediation-layer composition plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id",
    "written_at",
    "host",
    "objective",
    "spawn_tool_present",
    "mode",
    "skills",
    "terminate_when",
    "human_gate"
  ],
  "properties": {
    "plan_id": {"type": "string", "minLength": 1},
    "written_at": {"type": "string"},
    "host": {"type": "string"},
    "objective": {"type": "string", "minLength": 1},
    "spawn_tool_present": {"type": "boolean"},
    "mode": {"enum": ["compose-skills", "spawn-agents"]},
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "order", "why", "terminate_when"],
        "properties": {
          "name": {"type": "string"},
          "order": {"type": "integer", "minimum": 1},
          "why": {"type": "string"},
          "terminate_when": {"type": "string"}
        }
      }
    },
    "terminate_when": {"type": "string", "minLength": 1},
    "human_gate": {"type": ["string", "null"]},
    "note": {"type": "string"}
  }
}
