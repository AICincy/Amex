{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aai-turn-state",
  "title": "AAI turn state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "objective",
    "request_class",
    "authorized_scope",
    "constraints",
    "active_threads",
    "next_action",
    "completion_evidence",
    "human_gate",
    "takeover",
    "artifact_targets",
    "status",
    "missing_dependencies"
  ],
  "properties": {
    "objective": {"type": "string", "minLength": 1},
    "request_class": {
      "enum": ["ANSWER", "DIAGNOSE", "REVIEW", "BUILD", "CHANGE", "CONTINUE", "WAIT", "DECISION-GATED"]
    },
    "authorized_scope": {"type": "string", "minLength": 1},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "active_threads": {"type": "array", "items": {"type": "string"}},
    "next_action": {"type": "string", "minLength": 1},
    "completion_evidence": {"type": "string"},
    "human_gate": {"type": ["string", "null"]},
    "takeover": {"type": "boolean"},
    "artifact_targets": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["ACTIVE", "GATED", "BLOCKED", "COMPLETE"]},
    "missing_dependencies": {"type": "array", "items": {"type": "string"}}
  }
}
